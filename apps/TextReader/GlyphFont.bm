' ============================================================
' GlyphFont.bm
' Implementation for GlyphFont.bi
' ============================================================

Sub GFLoadFont ()
    Dim ch As Integer, i As Integer, k As Integer, ik As Integer
    Dim glyph As String
    For ch = 1 To 255
        Read glyph
        ik = 0
        For i = 0 To GFLW - 1
            For k = 0 To GFLH - 1
                ik = ik + 1
                GFLetter(ch, i + 1, k + 1) = Val(Mid$(glyph, ik, 1))
            Next k
        Next i
    Next ch
End Sub

Sub GFPrintText (txt As String, tleft As Integer, ttop As Integer, tmode As Integer)
    If tmode <> 2 And (ttop > _Height - 10 Or ttop < 50) Then Exit Sub
    Dim wl As Integer, wl1 As Integer, i As Integer, k As Integer, i2 As Integer
    Dim r As Integer, g As Integer, b As Integer
    Dim glyphColor As _Unsigned Long
    i2 = 0
    For wl = 1 To Len(txt)
        wl1 = Asc(Mid$(txt, wl, 1))
        If wl1 = 64 Then wl1 = 34
        If wl1 = 38 Then r = 0: g = 0: b = 0: i2 = 11
        If wl = Len(txt) And wl1 = 38 Then Exit For
        If wl1 = 94 Then r = 200: g = 0: b = 0: i2 = 11
        If tmode = 1 Then r = 80: g = 80: b = 180
        If tmode = 2 Then r = 250: g = 250: b = 250
        If wl1 <> 38 And wl1 <> 94 Then
            For i = 0 To GFLW - 1
                For k = 0 To GFLH - 1
                    If GFLetter(wl1, i + 1, k + 1) <> 0 Then
                        glyphColor = _RGBA(r, g, b, 255 - (GFLetter(wl1, i + 1, k + 1) - 1) * 30)
                        If ttop + k > 72 And ttop + k < _Height - 10 Then PSet (tleft + wl * GFLW + i - GFLW - i2, ttop + k), glyphColor
                    End If
                Next k
            Next i
        End If
    Next wl
End Sub

