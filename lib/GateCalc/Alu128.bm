' ============================================================
' Alu128.bm - 128-bit signed arithmetic built only from gates
' (implementation). Needs Gate.bm.
' ============================================================

' ------------------------------------------------------------
' Wiring: moving bits between the two halves. No gates here.
' ------------------------------------------------------------
Function Alu128Bit% (v As Word128, i As Integer)
    Dim r As Integer
    If i < 64 Then
        r = ((_ShR(v.lo, i) And 1) <> 0)
    Else
        r = ((_ShR(v.hi, i - 64) And 1) <> 0)
    End If
    Alu128Bit% = r
End Function

Sub Alu128SetBit (v As Word128, i As Integer)
    If i < 64 Then
        v.lo = v.lo Or _ShL(1&&, i)
    Else
        v.hi = v.hi Or _ShL(1&&, i - 64)
    End If
End Sub

Sub Alu128Shl1 (v As Word128)
    Dim carryBit As Integer
    carryBit = ((_ShR(v.lo, 63) And 1) <> 0)
    v.hi = _ShL(v.hi, 1)
    If carryBit Then v.hi = v.hi Or 1
    v.lo = _ShL(v.lo, 1)
End Sub

Sub Alu128Load (v As Word128, n As _Integer64)
    v.lo = n
    v.hi = 0
End Sub

' ------------------------------------------------------------
' The adder: a chain of full adders, one per bit, carry rippling
' straight across the join between the two halves.
' ------------------------------------------------------------
Sub Alu128Add (a As Word128, b As Word128, cin As Integer, nBits As Integer, sumOut As Word128, coutOut As Integer, ovfOut As Integer)
    Dim i As Integer, abit As Integer, bbit As Integer, sbit As Integer
    Dim cy As Integer, cyNext As Integer, cyMsb As Integer
    Dim r As Word128
    r.lo = 0
    r.hi = 0
    cy = (cin <> 0)
    cyMsb = cy
    For i = 0 To nBits - 1
        abit = Alu128Bit%(a, i)
        bbit = Alu128Bit%(b, i)
        cyMsb = cy
        GateFullAdd abit, bbit, cy, sbit, cyNext
        If sbit <> 0 Then Alu128SetBit r, i
        cy = cyNext
    Next
    sumOut = r
    coutOut = cy
    ovfOut = GateEval%(GATE_XOR, cyMsb, cy)
End Sub

' Subtract = add the inverted b with a carry in of 1.
Sub Alu128Sub (a As Word128, b As Word128, nBits As Integer, diffOut As Word128, borrowOut As Integer, ovfOut As Integer)
    Dim nb As Word128, cy As Integer
    nb.lo = Not b.lo
    nb.hi = Not b.hi
    Alu128Add a, nb, -1, nBits, diffOut, cy, ovfOut
    borrowOut = GateEval%(GATE_NOT, cy, 0)
End Sub

Sub Alu128Negate (a As Word128, rOut As Word128)
    Dim zero As Word128, r As Word128, bo As Integer, ov As Integer
    zero.lo = 0
    zero.hi = 0
    Alu128Sub zero, a, 128, r, bo, ov
    rOut = r
End Sub

Function Alu128IsZero% (v As Word128)
    Dim i As Integer, anyBit As Integer, r As Integer
    anyBit = 0
    For i = 0 To 127
        anyBit = GateEval%(GATE_OR, anyBit, Alu128Bit%(v, i))
    Next
    r = GateEval%(GATE_NOT, anyBit, 0)
    Alu128IsZero% = r
End Function

Sub Alu128Mag (v As Word128, rOut As Word128)
    Dim r As Word128
    If Alu128Bit%(v, 127) Then
        Alu128Negate v, r
    Else
        r = v
    End If
    rOut = r
End Sub

' ------------------------------------------------------------
' Shift-and-add into a 256-bit result held as two Word128s.
' a sits in a 256-bit shift register (shHi:shLo) that moves left
' one place per step; the bit leaving the top of shLo enters the
' bottom of shHi. For each set bit of b the register is added
' in, the low adder's carry out feeding the high adder's carry in.
' ------------------------------------------------------------
Sub Alu128MulU (a As Word128, b As Word128, hiOut As Word128, loOut As Word128)
    Dim i As Integer, cy As Integer, cy2 As Integer, ov As Integer, topBit As Integer
    Dim hw As Word128, lw As Word128, t As Word128
    Dim shHi As Word128, shLo As Word128
    hw.lo = 0
    hw.hi = 0
    lw.lo = 0
    lw.hi = 0
    shHi.lo = 0
    shHi.hi = 0
    shLo = a
    For i = 0 To 127
        If Alu128Bit%(b, i) Then
            Alu128Add lw, shLo, 0, 128, t, cy, ov
            lw = t
            Alu128Add hw, shHi, cy, 128, t, cy2, ov
            hw = t
        End If
        topBit = Alu128Bit%(shLo, 127)
        Alu128Shl1 shHi
        If topBit Then shHi.lo = shHi.lo Or 1
        Alu128Shl1 shLo
    Next
    hiOut = hw
    loOut = lw
End Sub

' Restoring division, one quotient bit per step. The bit shifted
' out of the top of the partial remainder (topOut) stands in for
' a 129th bit: when it is set the true remainder is at least
' 2^128, always bigger than d, so the subtract is kept even
' though the 128-bit subtractor reports a borrow - and its
' 128-bit result is exactly right.
Sub Alu128DivU (n As Word128, d As Word128, qOut As Word128, rOut As Word128)
    Dim i As Integer, bo As Integer, ov As Integer, topOut As Integer, keep As Integer
    Dim rmd As Word128, t As Word128, q As Word128
    rmd.lo = 0
    rmd.hi = 0
    q.lo = 0
    q.hi = 0
    For i = 127 To 0 Step -1
        topOut = Alu128Bit%(rmd, 127)
        Alu128Shl1 rmd
        If Alu128Bit%(n, i) Then rmd.lo = rmd.lo Or 1
        Alu128Sub rmd, d, 128, t, bo, ov
        keep = GateEval%(GATE_OR, topOut, GateEval%(GATE_NOT, bo, 0))
        If keep Then
            rmd = t
            Alu128SetBit q, i
        End If
    Next
    qOut = q
    rOut = rmd
End Sub

Sub Alu128MulS (a As Word128, b As Word128, resOut As Word128, ovfOut As Integer)
    Dim sa As Integer, sb As Integer, ng As Integer
    Dim hiNz As Integer, nz As Integer, sgnBad As Integer
    Dim ma As Word128, mb As Word128, hw As Word128, lw As Word128, r As Word128
    sa = Alu128Bit%(a, 127)
    sb = Alu128Bit%(b, 127)
    Alu128Mag a, ma
    Alu128Mag b, mb
    Alu128MulU ma, mb, hw, lw
    ng = GateEval%(GATE_XOR, sa, sb)
    hiNz = GateEval%(GATE_NOT, Alu128IsZero%(hw), 0)
    If ng Then
        Alu128Negate lw, r
    Else
        r = lw
    End If
    nz = GateEval%(GATE_NOT, Alu128IsZero%(r), 0)
    sgnBad = GateEval%(GATE_AND, nz, GateEval%(GATE_XOR, Alu128Bit%(r, 127), ng))
    resOut = r
    ovfOut = GateEval%(GATE_OR, hiNz, sgnBad)
End Sub

Sub Alu128DivS (a As Word128, b As Word128, qOut As Word128, rOut As Word128, divZero As Integer, ovfOut As Integer)
    Dim sa As Integer, sb As Integer, qs As Integer, nz As Integer
    Dim ma As Word128, mb As Word128, q As Word128, rr As Word128, t As Word128
    divZero = Alu128IsZero%(b)
    qOut.lo = 0
    qOut.hi = 0
    rOut.lo = 0
    rOut.hi = 0
    ovfOut = 0
    If divZero Then Exit Sub
    sa = Alu128Bit%(a, 127)
    sb = Alu128Bit%(b, 127)
    Alu128Mag a, ma
    Alu128Mag b, mb
    Alu128DivU ma, mb, q, rr
    qs = GateEval%(GATE_XOR, sa, sb)
    If qs Then
        Alu128Negate q, t
        q = t
    End If
    If sa Then
        Alu128Negate rr, t
        rr = t
    End If
    nz = GateEval%(GATE_NOT, Alu128IsZero%(q), 0)
    ovfOut = GateEval%(GATE_AND, nz, GateEval%(GATE_XOR, Alu128Bit%(q, 127), qs))
    qOut = q
    rOut = rr
End Sub

' ------------------------------------------------------------
' Double dabble into forty BCD digits (2^127 has 39). For each
' input bit from the top: add 3 to any digit that is 5 or more
' (a 4-bit slice of the adder), then shift every digit left one
' place, passing each digit's bit 3 up into the next digit's
' bit 0, and bring the input bit in at the bottom.
' ------------------------------------------------------------
Function Alu128Fmt$ (v As Word128)
    Dim dg(0 To 39) As _Integer64
    Dim mag As Word128, nib As Word128, tmp As Word128, three As Word128
    Dim i As Integer, k As Integer, cy As Integer, ov As Integer, ge5 As Integer
    Dim b3 As Integer, b2 As Integer, b1 As Integer, b0 As Integer
    Dim s As String, started As Integer
    Alu128Load three, 3
    Alu128Mag v, mag
    For i = 127 To 0 Step -1
        For k = 0 To 39
            Alu128Load nib, dg(k)
            b3 = Alu128Bit%(nib, 3)
            b2 = Alu128Bit%(nib, 2)
            b1 = Alu128Bit%(nib, 1)
            b0 = Alu128Bit%(nib, 0)
            ge5 = GateEval%(GATE_OR, b3, GateEval%(GATE_AND, b2, GateEval%(GATE_OR, b1, b0)))
            If ge5 Then
                Alu128Add nib, three, 0, 4, tmp, cy, ov
                dg(k) = tmp.lo
            End If
        Next
        For k = 39 To 1 Step -1
            dg(k) = (_ShL(dg(k), 1) And 15) Or (_ShR(dg(k - 1), 3) And 1)
        Next
        dg(0) = _ShL(dg(0), 1) And 15
        If Alu128Bit%(mag, i) Then dg(0) = dg(0) Or 1
    Next
    s = ""
    started = 0
    For k = 39 To 0 Step -1
        If dg(k) <> 0 Or started <> 0 Or k = 0 Then
            s = s + Mid$("0123456789", dg(k) + 1, 1)
            started = -1
        End If
    Next
    If Alu128Bit%(v, 127) Then s = "-" + s
    Alu128Fmt$ = s
End Function

' rOut = v * 10 + digit: the 256-bit gate multiply by ten, then
' the digit is added to the low word with its carry rippled into
' the high word. It fits only if the high word is zero and bit
' 127 of the low word is clear.
Sub Alu128DigitAppend (v As Word128, digit As Integer, rOut As Word128, okOut As Integer)
    Dim ten As Word128, hw As Word128, lw As Word128
    Dim dd As Word128, zero As Word128, s As Word128, h2 As Word128
    Dim cy As Integer, cy2 As Integer, ov As Integer
    Dim dgv As _Integer64
    Alu128Load ten, 10
    Alu128Load zero, 0
    dgv = digit
    Alu128Load dd, dgv
    Alu128MulU v, ten, hw, lw
    Alu128Add lw, dd, 0, 128, s, cy, ov
    Alu128Add hw, zero, cy, 128, h2, cy2, ov
    okOut = GateEval%(GATE_AND, Alu128IsZero%(h2), GateEval%(GATE_NOT, Alu128Bit%(s, 127), 0))
    rOut = s
End Sub
